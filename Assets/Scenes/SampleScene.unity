  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "There\u2019s a strange smell of popcorn. There are some pieces scattered
    on the floor. There are a lot of movies on the shelves, but it looks like the
    place is about to close. It\u2019s completely dark and I\u2019m alone. I tried
    calling someone, but no one is answering, and there\u2019s no signal. I\u2019m
    writing down everything I see in the notes on my phone. I hope the police find
    me. I don\u2019t really know where I am, but this place seems huge.\r\n\rFurther
    ahead, there\u2019s a supermarket. It\u2019s closed too, but there\u2019s a pizza
    corner inside that seems to be open. There\u2019s no one there either.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
