  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "I\u2019m exploring this place. It\u2019s crazy, but I can\u2019t seem
    to find an exit. I wonder what Stephany will say when I don\u2019t come home
    tonight.\r\n\rThere was a birthday party here. It looked a little sad, so I livened
    it up. It\u2019s completely silent, so I put on some music. I guess there were
    children here, or maybe it was a party for kids. I wonder where they all went.\r\n\rBut
    seriously, what a strange place to throw a party...\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
